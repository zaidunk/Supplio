# Salin ke .env.local lalu isi. JANGAN commit .env.local dan jangan taruh rahasia di NEXT_PUBLIC_*.

# --- Database (Supabase PostgreSQL) ---
# Runtime aplikasi (pooler Supabase, port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres"
# Migrasi Prisma (koneksi langsung, port 5432)
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# --- LLM: Google Gemini (LangChain.js) ---
# API key dari https://aistudio.google.com/apikey (server-side saja, jangan NEXT_PUBLIC_*).
GEMINI_API_KEY=""
# Model Flash stabil (bukan preview). Kosongkan untuk memakai default gemini-2.5-flash.
GEMINI_MODEL="gemini-2.5-flash"

# --- Telegram Bot API ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# String acak panjang; dikirim Telegram di header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=""
# Hanya untuk uji e2e dengan server Telegram palsu; kosongkan di dev/produksi (default https://api.telegram.org)
TELEGRAM_API_BASE_URL=""

# --- Inngest (wajib di deployment; opsional saat dev lokal) ---
# Dev lokal tanpa kunci: jalankan `npx inngest-cli@latest dev` dan set INNGEST_DEV=1.
# Tanpa INNGEST_SIGNING_KEY pada mode produksi, endpoint /api/inngest sengaja menolak melayani.
INNGEST_DEV=""
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Parameter operasional ---
# Masa berlaku ProcurementRequest sebelum EXPIRED (jam)
PROCUREMENT_REQUEST_EXPIRY_HOURS=24
# Batas waktu tunggu balasan supplier (menit)
SUPPLIER_RESPONSE_TIMEOUT_MINUTES=20
# Masa berlaku deep link onboarding Telegram (jam)
TELEGRAM_LINK_TOKEN_TTL_HOURS=48

# --- Seed (hanya prisma/seed.ts) ---
# UUID user Supabase Auth yang akan menjadi owner data seed
SEED_OWNER_USER_ID=""
